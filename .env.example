# --- Directus core -----------------------------------------------------------
SECRET=change-me-64-hex-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
PUBLIC_URL=https://pdam.example.com

# --- Database (an existing PostgreSQL 14+ server; not created by this compose) --
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pdam
DB_USER=admin
DB_PASSWORD=change-me

# --- Runtime ----------------------------------------------------------------
TELEMETRY=false
WEBSOCKETS_ENABLED=true
EXTENSIONS_AUTO_RELOAD=true
RATE_LIMITER_ENABLED=true
RATE_LIMITER_GLOBAL_LIMIT=20000
USER_REGISTRATION_ENABLED=false
PASSWORD_RESET_URL_ALLOW_LIST=https://pdam.example.com

# --- Agent surface (MCP) ----------------------------------------------------
MCP_ENABLED=true
# MCP_OAUTH_ENABLED=true
# MCP_OAUTH_DCR_ENABLED=true

# --- Host paths -------------------------------------------------------------
PDAM_DATA_DIR=/opt/data/pdam
