{
  "slug": "vps",
  "name": "VPS",
  "icon": "dns",
  "note": "Virtual private servers",
  "sort": 30,
  "group": "assets",
  "display_template": "{{name}}",
  "archive": {
    "field": "status",
    "value": "archived",
    "unarchive": "active"
  },
  "list": {
    "sort": [
      "name"
    ],
    "columns": [
      "name",
      "provider",
      "ipv4",
      "region",
      "os",
      "status"
    ],
    "widths": {
      "name": 200,
      "provider": 150,
      "ipv4": 140,
      "region": 120,
      "os": 130,
      "status": 110
    }
  },
  "index": {
    "name": "name",
    "provider": "provider.name",
    "account": "account.name",
    "expires": "expires_on",
    "renewal": null,
    "extra": [
      "hostname",
      "ipv4",
      "ipv6",
      "region",
      "os"
    ]
  },
  "fields": [
    {
      "field": "name",
      "type": "string",
      "length": 120,
      "required": true,
      "group": "basics"
    },
    {
      "field": "provider",
      "type": "m2o",
      "to": "providers",
      "required": true,
      "on_delete": "RESTRICT",
      "display": "provider.name",
      "group": "basics"
    },
    {
      "field": "account",
      "type": "m2o",
      "to": "accounts",
      "on_delete": "SET NULL",
      "display": "account.name",
      "group": "basics"
    },
    {
      "field": "hostname",
      "type": "string",
      "length": 255,
      "group": "basics"
    },
    {
      "field": "ipv4",
      "type": "string",
      "length": 15,
      "group": "network"
    },
    {
      "field": "ipv6",
      "type": "string",
      "length": 45,
      "group": "network"
    },
    {
      "field": "region",
      "type": "string",
      "length": 60,
      "group": "network"
    },
    {
      "field": "os",
      "type": "string",
      "length": 60,
      "group": "network"
    },
    {
      "field": "status",
      "type": "select",
      "default": "active",
      "choices": [
        "active",
        "inactive",
        "expired",
        "archived"
      ],
      "group": "lifecycle"
    },
    {
      "field": "expires_on",
      "type": "date",
      "group": "lifecycle"
    },
    {
      "field": "tags",
      "type": "tags",
      "to": "tags",
      "group": "extra"
    },
    {
      "field": "notes",
      "type": "text",
      "group": "extra"
    }
  ],
  "groups": [
    {
      "field": "basics",
      "title": "Basics"
    },
    {
      "field": "network",
      "title": "Network"
    },
    {
      "field": "lifecycle",
      "title": "Lifecycle"
    },
    {
      "field": "extra",
      "title": "Tags & Notes"
    }
  ]
}
