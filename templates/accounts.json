{
  "slug": "accounts",
  "name": "Accounts",
  "icon": "person",
  "note": "Logins you hold at a provider",
  "sort": 10,
  "group": "assets",
  "display_template": "{{name}}",
  "archive": {
    "field": "status",
    "value": "archived",
    "unarchive": "active"
  },
  "list": {
    "sort": [
      "name"
    ],
    "columns": [
      "name",
      "provider",
      "username",
      "email",
      "status"
    ],
    "widths": {
      "name": 220,
      "provider": 160,
      "username": 160,
      "email": 240,
      "status": 110
    }
  },
  "index": {
    "name": "name",
    "provider": "provider.name",
    "account": null,
    "expires": null,
    "renewal": null,
    "extra": [
      "username",
      "email",
      "url"
    ]
  },
  "fields": [
    {
      "field": "name",
      "type": "string",
      "length": 120,
      "required": true,
      "group": "basics"
    },
    {
      "field": "provider",
      "type": "m2o",
      "to": "providers",
      "required": true,
      "on_delete": "RESTRICT",
      "display": "provider.name",
      "group": "basics"
    },
    {
      "field": "username",
      "type": "string",
      "length": 120,
      "group": "basics"
    },
    {
      "field": "email",
      "type": "string",
      "length": 190,
      "format": "email",
      "group": "basics"
    },
    {
      "field": "url",
      "type": "string",
      "length": 255,
      "placeholder": "https://",
      "group": "basics"
    },
    {
      "field": "secret_reference",
      "type": "m2o",
      "to": "secret_references",
      "on_delete": "SET NULL",
      "display": "secret_reference.name",
      "group": "basics"
    },
    {
      "field": "status",
      "type": "select",
      "default": "active",
      "choices": [
        "active",
        "inactive",
        "archived"
      ],
      "group": "basics"
    },
    {
      "field": "tags",
      "type": "tags",
      "to": "tags",
      "group": "extra"
    },
    {
      "field": "notes",
      "type": "text",
      "group": "extra"
    }
  ],
  "groups": [
    {
      "field": "basics",
      "title": "Basics"
    },
    {
      "field": "extra",
      "title": "Tags & Notes"
    }
  ]
}
