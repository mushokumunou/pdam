{
  "slug": "secret_references",
  "name": "Secret References",
  "icon": "vpn_key",
  "note": "Pointers into an external vault. Never stores secrets.",
  "sort": 22,
  "group": "reference",
  "display_template": "{{name}}",
  "archive": {
    "field": "status",
    "value": "revoked",
    "unarchive": "active"
  },
  "list": {
    "sort": [
      "name"
    ],
    "columns": [
      "name",
      "secret_type",
      "provider",
      "last_rotated_at",
      "status"
    ],
    "widths": {
      "name": 220,
      "secret_type": 130,
      "provider": 130,
      "last_rotated_at": 170,
      "status": 110
    }
  },
  "fields": [
    {
      "field": "name",
      "type": "string",
      "length": 120,
      "required": true,
      "group": "basics"
    },
    {
      "field": "secret_type",
      "type": "select",
      "default": "password",
      "choices": [
        "password",
        "totp",
        "api_token",
        "ssh_key",
        "recovery_codes",
        "card",
        "other"
      ],
      "group": "basics"
    },
    {
      "field": "provider",
      "type": "select",
      "default": "vaultwarden",
      "choices": [
        "vaultwarden",
        "bitwarden",
        "1password",
        "generic"
      ],
      "group": "basics"
    },
    {
      "field": "reference",
      "type": "string",
      "length": 255,
      "required": true,
      "note": "item UUID / path — NOT a secret",
      "group": "basics"
    },
    {
      "field": "vault_url",
      "type": "string",
      "length": 255,
      "group": "basics"
    },
    {
      "field": "last_rotated_at",
      "type": "timestamp",
      "group": "basics"
    },
    {
      "field": "status",
      "type": "select",
      "default": "active",
      "choices": [
        "active",
        "rotated",
        "revoked"
      ],
      "group": "basics"
    },
    {
      "field": "notes",
      "type": "text",
      "group": "extra"
    }
  ],
  "groups": [
    {
      "field": "basics",
      "title": "Basics"
    },
    {
      "field": "extra",
      "title": "Notes"
    }
  ]
}
